{% form_theme form '@CookieConsent/form/cookie_consent_theme.html.twig' %}

{# Önálló süti sáv: saját CSS és JS (Resources/public), nem kell hozzá Bootstrap vagy jQuery; szövegekhez div, hogy az oldal p-szabályai ne hassanak rá #}
<link rel="stylesheet" href="{{ asset('bundles/cookieconsent/cookie-consent.css') }}">

<div class="cc-wrapper" data-cc-wrapper>
    {{ form_start(form) }}

    <div class="cc-banner cc-banner--{{ position }} {% if simplified %}cc-banner--simplified{% endif %}" role="region" aria-label="{{ 'cookie_consent_translation.settings_title'|trans({}, 'CookieConsentBundle') }}">
        {% block title %}
            <div class="cc-banner__text">
                {{ 'cookie_consent_translation.title'|trans({}, 'CookieConsentBundle') }}
                {% if not simplified %}
                    <a href="#" data-cc-open>{{ 'cookie_consent_translation.details_link'|trans({}, 'CookieConsentBundle') }}</a>
                {% endif %}
            </div>
        {% endblock %}
        <div class="cc-actions">
            {{ form_widget(form.use_all_cookies) }}
            {% if not simplified %}
                <button type="button" class="cc-btn cc-btn--secondary" data-cc-open>{{ 'cookie_consent_translation.show_cookie_settings_button'|trans({}, 'CookieConsentBundle') }}</button>
            {% endif %}
        </div>
    </div>

    {% if not simplified %}
    <dialog class="cc-dialog" data-cc-dialog tabindex="-1" aria-labelledby="ccDialogTitle">
        {# Fejléc: cím és bezárás, nem görög a tartalommal #}
        <div class="cc-dialog__header">
            <h2 class="cc-dialog__title" id="ccDialogTitle">{{ 'cookie_consent_translation.settings_title'|trans({}, 'CookieConsentBundle') }}</h2>
            <button type="button" class="cc-dialog__close" data-cc-close aria-label="{{ 'cookie_consent_translation.hide_cookie_settings_button'|trans({}, 'CookieConsentBundle') }}">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg>
            </button>
        </div>
        <div class="cc-dialog__body">
            <div class="cc-dialog__intro">{{ 'cookie_consent_translation.settings_intro'|trans({'{{ link }}': privacyPolicyUrl}, 'CookieConsentBundle')|raw }}</div>

            {# Kategóriák: a leírás a nyílra kattintva nyílik le #}
            <div class="cc-categories">
                {% include '@CookieConsent/_category.html.twig' with {
                    'name': 'necessary',
                    'input': '<input type="checkbox" checked disabled>',
                    'badge': 'cookie_consent_translation.always_active'|trans({}, 'CookieConsentBundle'),
                } %}

                {% for child in form %}
                    {% if child.vars.block_prefixes[0] != 'button' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <div class="cc-dialog__footer">
            {{ form_widget(form.use_only_selected) }}
            <button type="submit" name="{{ form.use_all_cookies.vars.full_name }}" class="cc-btn cc-btn--primary" data-cc-submit>{{ 'cookie_consent_translation.accept_all_button'|trans({}, 'CookieConsentBundle') }}</button>
        </div>
    </dialog>
    {% endif %}

    {{ form_end(form) }}
</div>

<script src="{{ asset('bundles/cookieconsent/cookie-consent.js') }}"></script>
