{# Kategória kapcsoló: a közös kategória sorral (_category.html.twig) #}
{% block checkbox_row -%}
    {% set input %}<input type="checkbox" id="{{ form.vars.id }}" name="{{ form.vars.full_name }}" value="{{ form.vars.value }}"{% if form.vars.checked %} checked{% endif %}>{% endset %}
    {% include '@CookieConsent/_category.html.twig' with {'name': name, 'input': input} %}
    {% do form.setRendered() %}
{%- endblock %}
